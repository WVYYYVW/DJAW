{
  "name": "djaw",
  "productName": "DJAW",
  "version": "0.3.10",
  "description": "DAW-style DJ mix editor",
  "main": "build/main.js",
  "private": true,
  "author": "WVYYYVW",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/ensure-electron.mjs && node scripts/build.mjs && electron .",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs --tests && node --test build/tests/*.test.js",
    "dist": "node scripts/ensure-electron.mjs && node scripts/build.mjs && electron-builder --win --publish never",
    "postinstall": "node scripts/ensure-electron.mjs",
    "dist:mac": "node scripts/ensure-electron.mjs && node scripts/build.mjs && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.djaw.mix",
    "productName": "DJAW",
    "files": [
      "build/**/*",
      "!build/tests/**",
      "!build/cli/**",
      "!build/**/*.map",
      "models/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/onnxruntime-node/**",
      "models/**",
      "assets/samples/**"
    ],
    "fileAssociations": [
      {
        "ext": "djaw",
        "name": "DJAW Mix",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signtoolOptions": {
        "sign": "./scripts/sign-win.cjs"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DJAW-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "npmRebuild": false,
    "artifactName": "DJAW-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "WVYYYVW",
        "repo": "DJAW"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "artifactName": "DJAW-${version}-mac-arm64.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "playwright-core": "^1.64.1",
    "typescript": "5.6"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "music-metadata": "^10.9.1",
    "onnxruntime-node": "1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "signalsmith-stretch": "^1.3.2"
  }
}
